@startuml Board_ClassDiagram
title Chess Engine - Board Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial

' ---- Types (ChessType.h) ----
class "Bitboard" as BB <<typedef>> {
    uint64_t
}

class "Square" as SQ <<typedef>> {
    int (a1 = 0 ... h8 = 63)
    NoSquare = -1
}

enum Color {
    White = 0
    Black = 1
}

enum PieceType {
    None = 0
    Pawn = 1
    Knight = 2
    Bishop = 3
    Rook = 4
    Queen = 5
    King = 6
}

enum CastlingRights {
    White_KingSide = 1
    White_QueenSide = 2
    Black_KingSide = 4
    Black_QueenSide = 8
}

' ---- Board ----
class Board {
    - byColor : Bitboard[2]
    - byType : Bitboard[7]
    - sideToMove : Color
    - castlingRights : uint8_t
    - enPassantSquare : Square
    - halfmoveClock : int
    - fullmoveNumber : int
    --
    + Board()
    + clear() : void
    + setFromFEN(fen : std::string) : bool
    + toFEN() : std::string
    + print() : void
    --
    + setPiece(sq : Square, c : Color, pt : PieceType) : void
    + removePiece(sq : Square) : void
    + isEmpty(sq : Square) : bool
    + pieceTypeAt(sq : Square) : PieceType
    + colorAt(sq : Square) : Color
    --
    + occupancy() : Bitboard
    + pieces(c : Color) : Bitboard
    + pieces(pt : PieceType) : Bitboard
    + pieces(c : Color, pt : PieceType) : Bitboard
    --
    + getSideToMove() : Color
    + setSideToMove(c : Color) : void
    + hasCastlingRight(cr : CastlingRights) : bool
    + removeCastlingRight(cr : CastlingRights) : void
    + getEnPassantSquare() : Square
    + setEnPassantSquare(sq : Square) : void
    + getHalfmoveClock() : int
    + getFullmoveNumber() : int
}

Board ..> BB : uses
Board ..> SQ : uses
Board ..> Color : uses
Board ..> PieceType : uses
Board ..> CastlingRights : uses

note right of Board
  byType is indexed directly by PieceType,
  so index 0 (None) is never used.
  pieces(c, pt) = byColor[c] & byType[pt]
  occupancy() = byColor[White] | byColor[Black]
  Squares: a1 = 0 ... h8 = 63
end note

@enduml
