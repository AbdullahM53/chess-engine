@startuml Board_ClassDiagram
title Chess Engine - Board Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial

' ---- Types ----
class "Bitboard" as BB <<typedef>> {
    uint64_t
}

class "Square" as SQ <<typedef>> {
    int (a1 = 0 ... h8 = 63)
}

enum Color {
    WHITE = 0
    BLACK = 1
}

enum PieceType {
    PAWN
    KNIGHT
    BISHOP
    ROOK
    QUEEN
    KING
    NONE
}

enum CastlingRight {
    WHITE_KINGSIDE = 1
    WHITE_QUEENSIDE = 2
    BLACK_KINGSIDE = 4
    BLACK_QUEENSIDE = 8
}

' ---- Main class ----
class Board {
    - byColor : Bitboard[2]
    - byType : Bitboard[6]
    - sideToMove : Color
    - castlingRights : uint8_t
    - enPassantSquare : Square
    - halfmoveClock : int
    - fullmoveNumber : int
    --
    + Board()
    + clear() : void
    + setFromFEN(fen : std::string) : bool
    + toFEN() : std::string
    --
    + setPiece(sq : Square, c : Color, pt : PieceType) : void
    + removePiece(sq : Square) : void
    + isEmpty(sq : Square) : bool
    + pieceTypeAt(sq : Square) : PieceType
    + colorAt(sq : Square) : Color
    --
    + occupancy() : Bitboard
    + pieces(c : Color) : Bitboard
    + pieces(pt : PieceType) : Bitboard
    + pieces(c : Color, pt : PieceType) : Bitboard
    --
    + getSideToMove() : Color
    + setSideToMove(c : Color) : void
    + hasCastlingRight(cr : CastlingRight) : bool
    + removeCastlingRight(cr : CastlingRight) : void
    + getEnPassantSquare() : Square
    + setEnPassantSquare(sq : Square) : void
    + getHalfmoveClock() : int
    + getFullmoveNumber() : int
}

Board ..> BB : uses
Board ..> SQ : uses
Board ..> Color : uses
Board ..> PieceType : uses
Board ..> CastlingRight : uses

note right of Board
  pieces(c, pt) = byColor[c] & byType[pt]
  occupancy() = byColor[WHITE] | byColor[BLACK]
  Squares: a1 = 0 ... h8 = 63
end note

@enduml
